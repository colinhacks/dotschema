// A schema with a codec in each place the pass reaches: a property, a $ref, an array's items, a
// tagged oneOf's variant and an anyOf beside null; and a $ref to a schema in another package, whose
// project has no codec, so its date-time stays a string.
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "at": { "type": "string", "format": "date-time" },
    "day": { "$ref": "#/$defs/day" },
    "seen": { "type": "array", "items": { "type": "string", "format": "date-time" } },
    "id": { "type": "string", "format": "int64" },
    "every": { "anyOf": [{ "type": "string", "format": "duration" }, { "type": "null" }] },
    "note": { "type": "string" },
    "stamp": { "$ref": "../codecs-other/stamp.schema.jsonc" },
    "kind": { "enum": ["click", "visit"] }
  },
  "required": ["at", "kind"],
  "$defs": {
    "day": { "type": "string", "format": "date" }
  },
  "oneOf": [
    { "properties": { "kind": { "const": "click" }, "x": { "type": "number" } }, "required": ["kind", "x"] },
    { "properties": { "kind": { "const": "visit" }, "until": { "type": "string", "format": "date-time" } }, "required": ["kind", "until"] }
  ]
}
