{
  "name": "dotschema",
  "version": "0.0.2",
  "private": true,
  "description": "Import a JSON Schema in a .schema.jsonc or .schema.json5 file as its TypeScript type and a validator compiled with ajv. A TypeScript 7.1 content mapper, a preload, and plugins for esbuild, Vite, webpack, Next.js and Jest.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinhacks/dotschema.git"
  },
  "homepage": "https://dotschema.vercel.app",
  "bugs": {
    "url": "https://github.com/colinhacks/dotschema/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./esbuild": "./src/esbuild.ts",
    "./vite": "./src/vite.ts",
    "./webpack": "./src/webpack.ts",
    "./turbopack": "./src/turbopack.ts",
    "./next": "./src/next.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "check-dist": "nub scripts/check-dist.ts",
    "bump": "nub scripts/bump.ts",
    "typecheck": "tsc --noEmit && tsc -p lab/basic/tsconfig.json --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ajv": "^8.11.0",
    "json5": "^2.2.2",
    "jsonc-parser": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "ajv-formats": "^3.0.1",
    "dotschema": "link:.",
    "esbuild": "^0.28.2",
    "typescript": "7.1.0-dev.20261002.1",
    "zod": "^4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.6",
      "onFail": "ignore"
    }
  }
}
