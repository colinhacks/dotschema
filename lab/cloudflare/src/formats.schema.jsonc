// Formats checked in workerd: Zod's jwt, base64, cidrv6 (which reads the address with the URL parser)
// and credit_card, date-time, and idn-hostname, idn-email and iri, which read Unicode properties and
// normalize, each checked by a function in a file of its own; and uuid, emoji and sha256_hex, regular
// expressions.
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": { "type": "string", "format": "jwt" },
    "data": { "type": "string", "format": "base64" },
    "network": { "type": "string", "format": "cidrv6" },
    "card": { "type": "string", "format": "credit_card" },
    "at": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "format": "uuid" },
    "mood": { "type": "string", "format": "emoji" },
    "digest": { "type": "string", "format": "sha256_hex" },
    "host": { "type": "string", "format": "idn-hostname" },
    "mail": { "type": "string", "format": "idn-email" },
    "link": { "type": "string", "format": "iri" },
  },
}
