// An instant and an int64, which dotschema.jsonc beside it decodes into a Temporal.Instant and a
// bigint in `.decode()`, and writes back in `.encode()`.
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "at": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "format": "int64" },
  },
  "required": ["at", "id"],
}
