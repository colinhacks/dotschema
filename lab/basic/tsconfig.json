{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    { "package": "dotschema", "extensions": [".schema.jsonc"] }
  ],
  "include": ["main.ts"]
}
