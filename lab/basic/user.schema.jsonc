{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    // `.validate()` trims the name before it checks it, and gives the trimmed name.
    "name": { "type": "string", "minLength": 1, "transform": ["trim"] },
    /** Where the app sends the user's mail. */
    "email": { "type": "string", "format": "email" },
    // A message of the schema's own, in place of ajv's; the issue's keyword is still `enum`.
    "role": { "enum": ["admin", "member"], "errorMessage": "must be admin or member" },
    // An absent `tags` is filled with its default, so the type `.validate()` gives has it.
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "default": [] },
    "address": { "$ref": "#/definitions/address" }
  },
  "required": ["name", "role"],
  "additionalProperties": false,
  // A definition is a validator of its own: `import { address } from "./user.schema.jsonc"`.
  "definitions": {
    "address": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string", "minLength": 1 }
      },
      "required": ["city"],
      "additionalProperties": false
    }
  }
}
